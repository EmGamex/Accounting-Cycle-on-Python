# Normalización automática de finales de línea por defecto
* text=auto eol=lf

# Archivos de código y documentación en texto plano (forzar LF y UTF-8)
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Scripts de terminal de Windows (requieren CRLF nativo)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios (evitar cualquier alteración de saltos de línea)
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
